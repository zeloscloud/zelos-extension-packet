# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments / uv state
.venv/
.uv/
.venv*/

# Tooling caches
.ty_cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/
*.tar.gz
# Standalone action inventory: regenerated from the code on every package run.
actions.json

# Captures and traces (never commit binary fixtures - tests generate them)
*.pcap
*.pcapng
*.trz

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# OS / editor junk (.vscode/ is committed - shared ruff/pytest settings)
.DS_Store
.idea/

# Zelos
.last_config
.uploaded.*
