{
  "name": "zelos-extension-packet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live network packet capture and pcap decode for Zelos",
  "author": "Zelos",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "eslint src/",
    "tsc": "tsc --noEmit && tsc -p tsconfig.node.json",
    "check": "npm run lint && npm run tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@zeloscloud/app-extension-sdk": "^0.4.1",
    "ag-grid-community": "^36.0.1",
    "ag-grid-react": "^36.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wildcard-match": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
